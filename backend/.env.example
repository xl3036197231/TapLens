TAPLENS_ENVIRONMENT=development
TAPLENS_HOST=127.0.0.1
TAPLENS_PORT=8000
TAPLENS_LOG_LEVEL=INFO
TAPLENS_DATABASE_PATH=./data/taplens.db
TAPLENS_ACCESS_TOKEN_MINUTES=60
TAPLENS_DAILY_QUOTA_LIMIT=10
TAPLENS_QUOTA_TIMEZONE=Asia/Shanghai

# 仅限本机受控站点联调。必须是精确的 http://127.0.0.1:<port>；生产环境禁止配置。
TAPLENS_TEST_ALLOWED_ORIGINS=

# 后续账号模块启用时必须替换为随机高强度值，禁止提交真实密钥。
TAPLENS_JWT_SECRET=replace-me-before-auth-is-enabled

# AI 幂等摘要必须使用与 JWT 无关的独立密钥。JSON 中保留旧版本可完成轮换窗口。
TAPLENS_AI_DIGEST_ACTIVE_KEY_VERSION=1
TAPLENS_AI_DIGEST_KEYS={"1":"replace-with-an-independent-random-secret"}
TAPLENS_AI_CALL_LEASE_SECONDS=90
TAPLENS_AI_RESPONSE_CACHE_HOURS=24
TAPLENS_AI_COMPACT_DAYS=30
TAPLENS_AI_CLEANUP_INTERVAL_SECONDS=3600
