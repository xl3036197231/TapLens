{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taplens.example/schemas/cloud-evidence.schema.json",
  "title": "TapLens Cloud Evidence",
  "description": "FROZEN-v1：Playwright云端深度分析返回给手机端的脱敏证据。",
  "$comment": "UUID、时间、状态、证据ID和错误对象统一引用 common.schema.json。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "task_id",
    "status",
    "generated_at",
    "initial_url",
    "final_url",
    "redirects",
    "requests",
    "forms",
    "blocked_actions",
    "page",
    "screenshot",
    "evidence",
    "limitations",
    "error",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"$ref": "./common.schema.json#/$defs/schema_version"},
    "analysis_id": {"$ref": "./common.schema.json#/$defs/analysis_id"},
    "task_id": {"$ref": "./common.schema.json#/$defs/task_id"},
    "status": {"$ref": "./common.schema.json#/$defs/cloud_task_status"},
    "generated_at": {"$ref": "./common.schema.json#/$defs/timestamp"},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 30000},
    "initial_url": {"$ref": "#/$defs/http_url"},
    "final_url": {
      "oneOf": [
        {"$ref": "#/$defs/http_url"},
        {"type": "null"}
      ]
    },
    "redirects": {
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "#/$defs/redirect"}
    },
    "requests": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/request"}
    },
    "forms": {
      "type": "array",
      "maxItems": 30,
      "items": {"$ref": "#/$defs/form"}
    },
    "blocked_actions": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/blocked_action"}
    },
    "page": {
      "oneOf": [
        {"$ref": "#/$defs/page"},
        {"type": "null"}
      ]
    },
    "screenshot": {
      "oneOf": [
        {"$ref": "#/$defs/screenshot"},
        {"type": "null"}
      ]
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "error": {
      "oneOf": [
        {"$ref": "./common.schema.json#/$defs/error"},
        {"type": "null"}
      ]
    },
    "expires_at": {
      "oneOf": [
        {"$ref": "./common.schema.json#/$defs/timestamp"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"enum": ["failed", "expired"]}},
        "required": ["status"]
      },
      "then": {"properties": {"error": {"$ref": "./common.schema.json#/$defs/error"}}},
      "else": {"properties": {"error": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {"status": {"const": "succeeded"}},
        "required": ["status"]
      },
      "then": {"properties": {"final_url": {"$ref": "#/$defs/http_url"}}}
    }
  ],
  "$defs": {
    "http_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_url", "to_url", "status_code"],
      "properties": {
        "from_url": {"$ref": "#/$defs/http_url"},
        "to_url": {"$ref": "#/$defs/http_url"},
        "status_code": {"type": ["integer", "null"], "minimum": 100, "maximum": 599}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "method", "resource_type", "status_code"],
      "properties": {
        "origin": {"$ref": "#/$defs/http_url"},
        "method": {"type": "string", "enum": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE", "OTHER"]},
        "resource_type": {"type": "string", "maxLength": 40},
        "status_code": {"type": ["integer", "null"], "minimum": 100, "maximum": 599}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "sensitive"],
      "properties": {
        "name": {"type": "string", "maxLength": 100},
        "type": {"type": "string", "maxLength": 40},
        "sensitive": {"type": "boolean"}
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "method", "fields"],
      "properties": {
        "action": {
          "oneOf": [
            {"$ref": "#/$defs/http_url"},
            {"type": "null"}
          ]
        },
        "method": {"type": "string", "enum": ["GET", "POST", "OTHER"]},
        "fields": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/field"}
        }
      }
    },
    "blocked_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "reason"],
      "properties": {
        "type": {"type": "string", "enum": ["form_submit", "business_post", "download", "popup", "external_protocol"]},
        "target": {"type": ["string", "null"], "maxLength": 2048},
        "reason": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "text_summary"],
      "properties": {
        "title": {"type": "string", "maxLength": 300},
        "text_summary": {"type": "string", "maxLength": 2000}
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "download_url", "expires_at"],
      "properties": {
        "artifact_id": {"$ref": "./common.schema.json#/$defs/uuid"},
        "download_url": {"$ref": "#/$defs/http_url"},
        "expires_at": {"$ref": "./common.schema.json#/$defs/timestamp"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "detail"],
      "properties": {
        "id": {"$ref": "./common.schema.json#/$defs/cloud_evidence_id"},
        "kind": {"type": "string", "enum": ["redirect", "request", "form", "blocked_action", "page", "screenshot", "error"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "detail": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
