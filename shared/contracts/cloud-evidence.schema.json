{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taplens.example/schemas/cloud-evidence.schema.json",
  "title": "TapLens Cloud Evidence",
  "description": "DRAFT: Playwright云端深度分析返回给手机端的脱敏证据。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "task_id",
    "status",
    "generated_at",
    "initial_url",
    "final_url",
    "redirects",
    "requests",
    "forms",
    "blocked_actions",
    "page",
    "screenshot",
    "evidence",
    "limitations",
    "error",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_id": {"type": "string", "format": "uuid"},
    "task_id": {"type": "string", "format": "uuid"},
    "status": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "failed", "expired"]
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 30000},
    "initial_url": {"type": "string", "format": "uri", "maxLength": 2048},
    "final_url": {
      "oneOf": [
        {"type": "string", "format": "uri", "maxLength": 2048},
        {"type": "null"}
      ]
    },
    "redirects": {
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "#/$defs/redirect"}
    },
    "requests": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/request"}
    },
    "forms": {
      "type": "array",
      "maxItems": 30,
      "items": {"$ref": "#/$defs/form"}
    },
    "blocked_actions": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/blocked_action"}
    },
    "page": {
      "oneOf": [
        {"$ref": "#/$defs/page"},
        {"type": "null"}
      ]
    },
    "screenshot": {
      "oneOf": [
        {"$ref": "#/$defs/screenshot"},
        {"type": "null"}
      ]
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "error": {
      "oneOf": [
        {"$ref": "#/$defs/error"},
        {"type": "null"}
      ]
    },
    "expires_at": {
      "oneOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {"properties": {"error": {"$ref": "#/$defs/error"}}}
    }
  ],
  "$defs": {
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_url", "to_url", "status_code"],
      "properties": {
        "from_url": {"type": "string", "format": "uri", "maxLength": 2048},
        "to_url": {"type": "string", "format": "uri", "maxLength": 2048},
        "status_code": {"type": ["integer", "null"], "minimum": 100, "maximum": 599}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "method", "resource_type", "status_code"],
      "properties": {
        "origin": {"type": "string", "format": "uri", "maxLength": 300},
        "method": {"type": "string", "enum": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE", "OTHER"]},
        "resource_type": {"type": "string", "maxLength": 40},
        "status_code": {"type": ["integer", "null"], "minimum": 100, "maximum": 599}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "sensitive"],
      "properties": {
        "name": {"type": "string", "maxLength": 100},
        "type": {"type": "string", "maxLength": 40},
        "sensitive": {"type": "boolean"}
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "method", "fields"],
      "properties": {
        "action": {
          "oneOf": [
            {"type": "string", "format": "uri", "maxLength": 2048},
            {"type": "null"}
          ]
        },
        "method": {"type": "string", "enum": ["GET", "POST", "OTHER"]},
        "fields": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/field"}
        }
      }
    },
    "blocked_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "reason"],
      "properties": {
        "type": {"type": "string", "enum": ["form_submit", "business_post", "download", "popup", "external_protocol"]},
        "target": {"type": ["string", "null"], "maxLength": 2048},
        "reason": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "text_summary"],
      "properties": {
        "title": {"type": "string", "maxLength": 300},
        "text_summary": {"type": "string", "maxLength": 2000}
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "download_url", "expires_at"],
      "properties": {
        "artifact_id": {"type": "string", "format": "uuid"},
        "download_url": {"type": "string", "format": "uri", "maxLength": 2048},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "detail"],
      "properties": {
        "id": {"type": "string", "pattern": "^C[0-9]{2,}$"},
        "kind": {"type": "string", "enum": ["redirect", "request", "form", "blocked_action", "page", "screenshot", "error"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "detail": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {"type": "string", "pattern": "^(AUTH|QUOTA|CLOUD)_[A-Z0-9_]+$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 300},
        "retryable": {"type": "boolean"},
        "details": {"type": ["object", "null"], "additionalProperties": true}
      }
    }
  }
}
